+                "waiting_for_queue" if active else "running",
+                completed,
+                failed,
+            )
+            if progress != last_progress:
+                credential_health_scheduler.update_progress(
+                    "chatgpt2api_401",
+                    run_id,
+                    phase=progress[0],
+                    detected=len(items),
+                    actionable=len(remote_ids),
+                    submitted=submitted,
+                    completed=completed,
+                    failed=failed,
+                    skipped=initial_skipped,
+                )
